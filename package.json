{
  "name": "stub-auth",
  "version": "1.10.9",
  "description": "Stub AI provider driver for basekit/auth: canned responses to validate the auth pipeline; the reference example for building provider plugins.",
  "main": "dist/index.js",
  "type": "module",
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intisy-ai/stub-auth.git"
  },
  "keywords": [
    "basekit",
    "provider",
    "stub",
    "auth",
    "example"
  ],
  "files": [
    "dist/",
    "plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "claudeHub": {
    "authProviders": [
      {
        "name": "stub",
        "handler": "dist/handler.js",
        "models": [
          {
            "id": "stub-model",
            "name": "Stub Default"
          },
          {
            "id": "stub-pro",
            "name": "Stub Pro"
          },
          {
            "id": "stub-fast",
            "name": "Stub Fast"
          }
        ]
      }
    ]
  },
  "scripts": {
    "emit:teavm": "node node_modules/@intisy/bayonet/scripts/emit-dts.mjs --java-dir . --module :stub-teavm --out src/generated",
    "build": "npm run emit:teavm && node node_modules/@intisy/bayonet/scripts/teavm-build.mjs --java-dir . --module :stub-teavm --out src/generated/stub-provider.teavm.js && node build.mjs",
    "postbuild": "node dist/index.js readme",
    "test": "npm run build && npm run typecheck && vitest run",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@intisy/bayonet": "^1.7.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@intisy-ai/basekit": "^4.0.0"
  }
}
